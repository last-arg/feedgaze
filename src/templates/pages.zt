const util = @import("../util.zig");
const builtin = @import("builtin");
const feed_types = @import("../feed_types.zig");
const Server = @import("../server.zig");
const IconManage = Server.IconManage;
const Storage = @import("../storage.zig").Storage;
const UrlQueryError = Server.UrlQueryError;
const TagResult = Storage.TagResult;

fn hash_static_file(comptime path: []const u8) u64 {
    @setEvalBranchQuota(60000);
    const c = @embedFile(path);
    var hasher = std.hash.Wyhash.init(0);
    hasher.update(c);
    return hasher.final();
}

pub fn file_type(filename: []const u8) enum{js,css} {
    const last_dot_index = std.mem.lastIndexOfScalar(u8, filename, '.') orelse
        @compileError("'filename is missing file extension. Valid file extensions: js, css'");

    const filetype = filename[last_dot_index + 1..];
    if (std.mem.eql(u8, filetype, "css")) {
        return .css;
    } else if (std.mem.eql(u8, filetype, "js")) {
        return .js;
    }

    @compileError("File has to have .js or .css extension");
}

const path_server = if (builtin.mode == .debug) "../server/" else "../server/dist/";
pub const static_files_map = .{
    .{.filename = "main.css", .hash = hash_static_file(path_server ++ "main.css")},
    .{.filename = "main.js", .hash = hash_static_file(path_server ++ "main.js")},
    .{.filename = "relative-time.js", .hash = hash_static_file(path_server ++ "relative-time.js")},
};

pub fn get_static_path(comptime filename: []const u8) []const u8 {
    const hash = comptime blk: {
        for (static_files_map) |file| {
            if (std.mem.eql(u8, file.filename, filename)) {
                break :blk file.hash;
            }
        }
        @compileError("Invalid static file input: " ++ filename);
    };

    return std.fmt.comptimePrint("/public/{x}-{s}",.{hash, filename});
}

const reload_js = @embedFile("../server/reload.js");
pub templ Layout(title: []const u8, nav: Navigation) {
    <!DOCTYPE html>
    <html lang="en">
      <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta http-equiv="X-UA-Compatible" content="ie=edge" />
        <title>{title}</title>
        if (builtin.mode == .debug) {
            {!"<script async>" ++ reload_js ++ "</script>"}
        }
        <script>
            /*! kelpui v1.6.3 | (c) Chris Ferdinandi | http://github.com/cferdinandi/kelp */
            "use strict";
            (() => {
              // modules/js/dark-mode-auto.js
              var prefersDarkMode = window.matchMedia("(prefers-color-scheme: dark)");
              document.documentElement.classList.toggle("dark", prefersDarkMode.matches);
              prefersDarkMode.addEventListener("change", (event) => {
                document.documentElement.classList.toggle("dark", event.matches);
              });
            })();
        </script>
        <link rel="stylesheet" type="text/css" href={get_static_path("main.css")} />
        <link rel="stylesheet" type="text/css" href="/public/{nav.css_icons_hash}-icons.css" />
        <script defer src={get_static_path("main.js")}></script>
        <script async type="module" src={get_static_path("relative-time.js")}></script>
      </head>
      <body>
        <div>
            @Nav(nav)
            @children
        </div>
      </body>
    </html>
}

const menu_items = [_]struct{path: []const u8, name: []const u8}{
    .{.path = "/feeds", .name = "Feeds"},
    .{.path = "/tags", .name = "Tags"},
    .{.path = "/feed/add", .name = "Add feed"},
    .{.path = "/failed-requests", .name = "Failed feed requests"},
};

pub const Navigation = struct {
    current_path: []const u8 = "/",
    tags: []const TagResult = &.{},
    search_value: []const u8 = "",
    has_untagged: bool = false,
    tags_active: []const feed_types.SqliteId = &.{},
    css_icons_hash: u64 = 0,
};

pub fn is_tag_checked(tag_id: feed_types.SqliteId, tags_checked: []const feed_types.SqliteId) bool {
    return std.mem.findScalar(feed_types.SqliteId, tags_checked, tag_id) != null;
}

const untagged = "[untagged]";
pub templ Nav(nav: Navigation) {
    <header class="body-header">
      <div class="nav">
        <h1>
          <a href="/" aria-current={if (std.mem.eql(u8, nav.current_path, "/")) "page" else null}>feedgaze</a>
        </h1>
        <nav>
            for (menu_items) |item| {
                <span>|</span>
                <a href="{item.path}" aria-current={if (std.mem.eql(u8, nav.current_path, item.path)) "page" else null}>{item.name}</a>
            }
        </nav>
      </div>
      <details>
        <summary>Filter feeds</summary>
        <div class="filter-wrapper">
          <form action="/feeds" class="stack">
            <!-- NOTE: don't want tags-only button to be the 'default' button. This is
            used when enter is pressed in input (text) field. -->
            <button aria-hidden="true" style="display: none">Default form action</button>
            <fieldset class="tags stack">
              <legend>Tags</legend>
              <div class="tag-list">
                <div class="tag">
                  <input type="checkbox" name="untagged" id="untagged" checked?={nav.has_untagged} />
                  <label class="visually-hidden" for="untagged">{untagged}</label>
                  <a class="truncate-1" href="/feeds?untagged=" title="untagged">{untagged}</a>
                </div>

              for (nav.tags) |tag| {
                  <div class="tag">
                    <input type="checkbox" name="tag" id="tag-id-{tag.tag_id}" value="{tag.name}" checked?={is_tag_checked(tag.tag_id, nav.tags_active)} />
                    <label class="visually-hidden" for="tag-id-{tag.tag_id}">{tag.name}</label>
                    <a class="truncate-1" href="/feeds?tag={tag.name}" title="{tag.name}">{tag.name}</a>
                  </div>
              }
              </div>
            </fieldset>
            <div><button class="muted secondary" name="tags-only">Filter tags only</button></div>
            <div>
              <label class="form-heading" for="search_value">Filter feeds</label>
              <div class="input-search-wrapper"><input type="search" name="search" id="search_value" value={nav.search_value} /></div>
              <button class="form-submit muted primary">Filter all</button>
            </div>
          </form>
        </div>
      </details>
      <hr />
    </header>
}


pub const HomeContent = struct {
    next_update_ts: ?i64 = null,
    items: []const feed_types.FeedItemRender = &.{},
    feeds: []const feed_types.Feed = &.{},
    failed_requests: []const feed_types.Feed.ID = &.{},
    cookie_last_item_ts: i64 = 0,
    now_sec: i64,
    display_feed_delete_msg: bool = false,
};

pub templ HomePage(content: HomeContent, nav: Navigation) {
    @Layout("Home - latest added feed items", nav) {
        <main class="content-latest flow">
            if (content.display_feed_delete_msg) {
                <div class="message">
                  <p>Feed deleted</p>
                  <a href="/">Close message</a>
                </div>
            }

            <header class="main-header">
                <h2>Latest added</h2>
                if (content.next_update_ts) |countdown_ts| {
                    <div class="heading-info">
                        <relative-time update="false">
                            <p class="update-automatic">Next update <time datetime={zt.fmt(util.write_timestamp, .{countdown_ts})}>{util.date_readable(countdown_ts)}</time></p>

                            <div class="update-manual" hidden>
                                <p>Last update was <time datetime={zt.fmt(util.write_timestamp, .{countdown_ts})}>{util.date_readable(countdown_ts)}</time>.</p>
                                <form method="POST" action="/update">
                                  <p>
                                    <button class="btn-link">Check for updates.</button>
                                    Might take some time.
                                  </p>
                                </form>
                            </div>
                        </relative-time>
                    </div>
                }
            </header>
            if (content.items.len == 0) {
                <p class="callout">No feed items have been added in the previous 3 days</p>
            } else {
                <relative-time update="false" format-style="narrow" format-numeric="always">
                <ul class="stack list-unstyled">
                for (content.items) |item| {
                    <li class="feed-item">
                       @FeedItemLatest(item, get_feed_with_id(item.feed_id, content.feeds), LatestOptions{
                           .is_new_item = item.created_timestamp > content.cookie_last_item_ts,
                           .now_sec = content.now_sec,
                           .has_request_failed = has_request_failed(item.feed_id, content.failed_requests),
                       })
                    </li>
                }
                </ul>
                </relative-time>
            }
        </main>
    }
}

fn has_request_failed(feed_id: feed_types.Feed.ID, failed_requests: []const feed_types.Feed.ID) bool {
  if (std.mem.indexOfScalar(feed_types.Feed.ID, failed_requests, feed_id)) |_| {
      return true;
  }
  return false;
}


const LatestOptions = struct {
    is_new_item: bool = false,
    has_request_failed: bool = false,
    now_sec: i64,
};

const failed_request_msg = "Latest update to this feed failed";

pub templ FeedItemLatest(item: feed_types.FeedItemRender, feed: feed_types.Feed, opts: LatestOptions) {
    <div class="feed-time">
        @LatestItemRelativeTime(item.updated_timestamp, opts.now_sec)
        if (opts.is_new_item) {
            <span>new</span>
        }
    </div>

    @ItemLink(item)

    <div class="item-extra">
        <div>
            <a href="/feed/{feed.feed_id}" title="{feed.title}">{feed.title}</a>

            if (opts.has_request_failed) {
                <span class="mi-start-5xs feed-failed-icon" title="{failed_request_msg}"></span>
                <span class="visually-hidden">{failed_request_msg}</span>
            }
        </div>

        <a class="feed-external-url {IconIdClass.init(feed.icon_id)}" href="{feed.page_url orelse feed.feed_url}" rel="noreferrer noopener">
            <span>{zt.fmt(util.write_url_domain, .{feed.page_url orelse feed.feed_url})}</span>
        </a>
    </div>
}

pub fn get_feed_with_id(feed_id: feed_types.Feed.ID, feeds: []const feed_types.Feed) feed_types.Feed {
    for (feeds) |feed| {
        if (feed.feed_id == feed_id) {
            return feed;
        }
    }
    unreachable;
}

pub templ LatestItemRelativeTime(ts_opt: ?i64, now_sec: i64) {
    if (ts_opt) |ts| {
        <time class="{util.age_class_from_time(now_sec, ts)}" datetime="{zt.fmt(util.write_timestamp, .{ts})}">
            {zt.fmt(util.write_display_date, .{now_sec, ts})}
        </time>
    } else {
        <span class="no-date">&#8212;</span>
    }
}

pub const TagsContent = struct {
    query_error: ?UrlQueryError = null,
    query_is_success: bool = false,
};

pub templ TagsPage(content: TagsContent, nav: Navigation) {
    @Layout("Tags", nav) {
        <main class="flow">
          <header class="main-header"><h2>Tags</h2></header>
          if (content.query_is_success) {
              <p class="callout success">Tag deleted</p>
          } else if (content.query_error) |query_error| {
              switch (query_error) {
                  .delete => {<p class="callout danger">Failed to delete tag</p>},
                  .missing => {<p class="callout warning">Tag doesn't exist</p>},
                  else => {},
              }
          }

          <ul class="tags-all stack list-unstyled" role="list">
              for (nav.tags) |tag| {
                <li class="tag-item">
                  <a class="truncate-1" href="/feeds?tag={tag.name}" title="{tag.name}">{tag.name}</a>

                  <div class="tag-actions cluster align-center">
                    <a href="/tag/{tag.tag_id}/edit">Edit</a>
                    <form action="/tag/{tag.tag_id}/delete" method="POST">
                        <button class="btn-link padding-0 danger" name="action" value="delete">Delete</button>
                    </form>
                  </div>
                </li>
                }
          </ul>
        </main>
    }
}

pub const FailedFeedsContent = struct {
    failed_requests: []const Storage.FeedFailedRequestWithID,
};

const title_placeholder = "[no-title]";

pub templ FailedFeedsPage(content: FailedFeedsContent, nav: Navigation) {
    @Layout("Failed feed requests", nav) {
        <h2>Failed feed requests</h2>
        if (content.failed_requests.len == 0) {
            <p>No failed feed requests</p>
        } else {
            for (content.failed_requests) |failed_request| {
                <section class="failed-feed">
                    <header class={IconIdClass.init(failed_request.icon_id)}>
                        <h3 class="truncate-1">
                        if (failed_request.page_url) |page_url| {
                            <a href="{page_url}" title="{failed_request.title orelse title_placeholder}">
                                {failed_request.title orelse title_placeholder}
                            </a>
                        } else {
                            {failed_request.title orelse title_placeholder}
                        }
                        </h3>
                        <a class="one-line" href="{failed_request.feed_url}">Feed link</a>
                        <a href="/feed/{failed_request.feed_id}">Edit</a>
                    </header>

                    <p>Latest error <time datetime="{zt.fmt(util.write_timestamp, .{failed_request.utc_sec})}">
                        ({util.date_readable(failed_request.utc_sec)})</time>: {failed_request.reason}
                    </p>
                </section>
            }
        }
    }
}

pub const FeedAddOpts = struct {
    query_success: ?std.fmt.ParseIntError!u64 = null,
    query_feed_exists: ?std.fmt.ParseIntError!u64 = null,
    query_error: ?UrlQueryError = null,
    input_url: []const u8 = "",
    input_tags: []const u8 = "",
};

pub templ FeedAddPage(opts: FeedAddOpts, nav: Navigation) {
    @Layout("Add feed", nav) {
        <main class="flow">
            <header class="main-header"><h2>Add feed</h2></header>
            if (opts.query_success) |success_err| {
                if (success_err) |feed_id| {
                    <p class="callout success">Feed added.
                        <a href="/feed/{feed_id}">Got to feed page</a>.
                    </p>
                } else |err| {
                    <p>Please provide valid feed ID. Error: {err}</p>
                }
            } else if (opts.query_feed_exists) |feed_exists_err| {
                if (feed_exists_err) |feed_id| {
                    <p>Feed already exists.
                        <a href="/feed/{feed_id}">Got to feed page</a>.
                    </p>
                } else |err| {
                    <p>Please provide valid feed ID. Error: {err}</p>
                }
            } else if (opts.query_error) |err_enum| {
                 switch (err_enum) {
                     .invalid_url => {<p class="callout danger">Enter valid feed/page link</p>},
                     .url_missing => {<p class="callout danger">Fill in feed/page link</p>},
                     else => {},
                 }
            }

            <form action="/feed/add" method="POST" class="flow" style="--flow-space: var(--size-4xl)">
                <div>
                    <div><label for="input-url">Feed/Page link</label></div>
                    <input type="text" class="char-len-l" id="input-url" name="input-url" value="{opts.input_url}" />
                </div>

                <div>
                    <div class="label-wrapper">
                        <label for="input-tags">Tags (optional)</label>
                        <em>Tags are comma separated</em>
                    </div>
                    <input type="text" class="char-len-m" id="input-tags" name="input-tags" value="{opts.input_tags}" />
                </div>

                <button class="primary muted">Add new feed</button>
            </form>
        </main>
    }
}

pub const FeedPickOpts = struct {
    query_feed_exists: ?std.fmt.ParseIntError!u64 = null,
    query_error: ?UrlQueryError = null,
    input_url: []const u8 = "",
    input_tags: []const u8 = "",
    query_picked_index: u32 = 0,
    query: *@import("httpz").key_value.StringKeyValue,
    writer: *std.Io.Writer,
    is_html_checked: bool = false,
    html_opts: @import("../feed_parse.zig").HtmlOptions,
};

pub templ FeedPickPage(opts: FeedPickOpts, nav: Navigation) {
    @Layout("Pick feed", nav) {
        <main class="flow">
            <header class="main-header"><h2>Pick feed</h2></header>
            if (opts.query_feed_exists) |result_err| {
                if (result_err) |feed_id| {
                    <p class="callout">Feed already exists.
                        <a href="/feed/{feed_id}">Got to feed page</a>.
                    </p>
                } else |err| {
                    <p class="callout danger">Invalid feed ID. Error: {err}</p>
                }
            } else if (opts.query_error) |query_error| {
                switch (query_error) {
                    .invalid_url => {<p class="callout danger">Enter valid url.</p>},
                    .url_missing => {<p class="callout danger">Pick feed option.</p>},
                    .empty_selector => {<p class="callout danger">Fill in 'Feed item selector'.</p>},
                    .pick_url => {<p class="callout danger">Pick one of the feed options.</p>},
                    .fetch_failed => {<p class="callout danger">Failed to fetch feed.</p>},
                    .fetch_status_not_ok => {
                        <p class="callout danger">
                            <span>Failed to fetch feed because returned status code wasn't 200 (OK).</span>
                            if (opts.query.get("fetch_status")) |status| {
                                Returned status code: {status}
                            }
                        </p>
                    },
                    else => {}
                }
            }

            <form action="/feed/pick" method="POST" class="flow" style="--flow-space: var(--size-4xl)">
                <div>
                    <label>Feed/Page link</label>
                    <input class="char-len-l" type="text" readonly name="input-url" value={opts.input_url} />
                </div>

                <fieldset>
                    <legend>Pick feed to add</legend>

                    <ul class="list-unstyled margin-end-0">
                        {try render_picks(opts.query, opts.query_picked_index, opts.writer)}
                        <li>
                            <label for="url-html">
                                <input type="radio" id="url-html" name="url-picked" value="html" checked?={opts.is_html_checked} />
                                Html as feed
                            </label>
                        </li>
                    </ul>
                    <div>
                        <noscript>
                            <p class="callout">
                                Fill these fields if you picked "Html as feed".
                            </p>
                        </noscript>
                        <div class="html-feed-inputs flow">
                            <div>
                                <label for="feed-container">Html item selector</label>
                                <input type="text" id="feed-container" name="selector-container" value="{opts.html_opts.selector_container}" />
                            </div>

                            <p class="callout">Rest of the fields are optional. And selector fields root (starting point) is feed item selector.</p>

                            <div>
                                <div class="label-wrapper">
                                    <label for="feed-link">Html link selector (optional)</label>
                                    <em>Fallback is &lt;a&gt; href value</em>
                                </div>
                                <input type="text" id="feed-link" name="selector-link" value="{opts.html_opts.selector_link}" />
                            </div>

                            <div>
                                <div class="label-wrapper">
                                    <label for="feed-heading">Html heading selector (optional)</label>
                                    <em>Fallback are headings (&lt;h1&gt;-&lt;h6&gt;). After that whole item container's text will be used.</em>
                                </div>
                                <input type="text" id="feed-heading" name="selector-heading" value="{opts.html_opts.selector_heading}" />
                            </div>

                            <div>
                                <div class="label-wrapper">
                                    <label for="feed-date">Html date selector (optional)</label>
                                    <em>Fallback is &lt;time&gt.</em>
                                </div>
                                <input type="text" id="feed-date" name="selector-date" value="{opts.html_opts.selector_date}" />
                            </div>

                            <div>
                                <div class="label-wrapper">
                                    <label for="feed-date-format">Html date format (optional)</label>
                                    <em>Fallback is date format that &lt;time&gt; uses.</em>
                                </div>
                                <input type="text" id="feed-date-format" name="feed-date-format" value="{opts.html_opts.date_format}" />
                            </div>

                        </div>
                    </div>
                </fieldset>

                <div>
                    <div class="label-wrapper">
                        <label for="input-tags">Tags (optional)</label>
                        <em>Tags are comma separated</em>
                    </div>
                    <input class="char-len-m" id="input-tags" name="input-tags" value="{opts.input_tags}" />
                </div>

                <div class="form-actions">
                    <button class="primary muted">Add new feed</button>
                    <a href="/feed/add">Cancel</a>
                </div>
            </form>
        </main>
    }
}

pub fn render_picks(query: *@import("httpz").key_value.StringKeyValue, picked_index: u32, w: *std.Io.Writer) !void {
    var index: u32 = 0;
    for (query.keys, query.values) |key, value| {
        if (std.mem.eql(u8, "url", key)) {
            try PickItem.render(.{value, index, index == picked_index}, w);
            index += 1;
        }
    }
}

pub templ PickItem(value: []const u8, index: u32, is_checked: bool) {
    <li>
        <input type="hidden" name="url" value="{value}" />
        <label for="url-{index}">
            <input type="radio" id="url-{index}" name="url-picked" value="{value}" checked?={is_checked} />
            {value}
        </label>
    </li>
}

pub const FeedsOpts = struct {
    feeds: []const feed_types.Feed,
    items: []const feed_types.FeedItemRender = &.{},
    failed_requests: []const feed_types.Feed.ID = &.{},
    now_sec: i64 = 0,
    feeds_tags: []const Storage.FeedTag = &.{},
    footer: ?struct{
        base: []const u8,
        prev: ?feed_types.Feed.ID,
        next: feed_types.Feed.ID,
    } = null,
};

pub templ FeedsPage(opts: FeedsOpts, nav: Navigation) {
    @Layout("Feeds", nav) {
        <main class="flow">
            <header class="main-header">
              <h2>Feeds</h2>
              <div class="main-actions cluster">
                  <button class="outline js-expand-all">Expand all</button>
                  <button class="outline js-collapse-all">Collapse all</button>
              </div>
            </header>

            if (opts.feeds.len > 0) {
                <div class="flow">
                for (opts.feeds) |feed| {
                    <article class="feed">
                        <header>
                            <div class="feed-header-top {IconIdClass.init(feed.icon_id)}">

                            if (feed.page_url) |page_url| {
                                <a class="feed-title truncate-1" href="{page_url}" rel="noreferrer noopener" title="{feed.title orelse title_placeholder}">{feed.title orelse title_placeholder}</a>
                            } else {
                                <p class="feed-title truncate-1">{feed.title orelse title_placeholder}</p>
                            }

                                @LatestItemRelativeTime(feed.updated_timestamp, opts.now_sec)
                                <a class="feed-edit" href="/feed/{feed.feed_id}">Edit feed</a>
                            </div>

                            if (std.mem.indexOfScalar(feed_types.Feed.ID, opts.failed_requests, feed.feed_id)) |_| {
                                <p class="feed-failed-msg feed-failed-icon">Last update failed</p>
                            }

                            if (feed_tags_slice(feed.feed_id, opts.feeds_tags)) |feed_tags| {
                                <div class="feed-tags">
                                    <ul class="list-unstyled" aria-label="Feed tags">
                                    for (feed_tags) |feed_tag| {
                                        if (get_tag_name(feed_tag.tag_id, nav.tags)) |tag_name| {
                                            <li>
                                                <a class="badge" href="/feeds?tag={tag_name}" title="{tag_name}">{tag_name}</a>
                                            </li>
                                        }
                                    }
                                    </ul>
                                </div>
                            }
                        </header>

                        if (feed_items_slice(feed.feed_id, opts.items)) |items| {
                            <relative-time update="false" format-style="narrow" format-numeric="always">
                                <ul class="stack list-unstyled">
                                for (items) |item| {
                                    <li class="feed-item">
                                        @LatestItemRelativeTime(item.updated_timestamp, opts.now_sec)
                                        @ItemLink(item)
                                    </li>
                                }
                                </ul>
                            </relative-time>
                        } else {
                            <p class="callout size-xs">Feed has no items.</p>
                        }

                        <footer class="feed-footer">
                          <button class="outline js-feed-item-toggle" aria-expanded="true">
                            <span class="toggle-expand">Expand</span>
                            <span class="toggle-collapse">Collapse</span>
                          </button>
                        </footer>
                    </article>
                }

                if (opts.footer) |f| {
                    <footer class="main-footer">
                        <hr />
                        if (f.prev) |prev| {
                            <a href="{f.base}&before={prev}">Previous</a>
                        }
                        <a href="{f.base}&after={f.next}">Next</a>
                    </footer>
                }

                </div>
            } else {
                <p class="callout">No feeds to show</p>
            }

        </main>
    }
}

const no_title = "[no-text-content]";
pub templ ItemLink(item: feed_types.FeedItemRender) {
    if (item.link) |link| {
        <a href="{link}" class="item-link truncate-2" title={if (item.title.len > 0) item.title else no_title} rel="noreferrer noopener">
            {if (item.title.len > 0) item.title else no_title}
        </a>
    } else {
        <p class="truncate-2" title={if (item.title.len > 0) item.title else no_title}>
            {if (item.title.len > 0) item.title else no_title}
        </p>
    }
}

fn feed_tags_slice(feed_id: feed_types.Feed.ID, feeds_tags: []const Storage.FeedTag) ?[]const Storage.FeedTag {
    var start: ?usize = null;
    for (feeds_tags, 0..) |feed_tag, i| {
        if (feed_tag.feed_id == feed_id) {
            start = i;
            break;
        }
    }

    if (start) |s| {
        const slice = feeds_tags[s..];
        for (slice[1..], 1..) |feed_tag, i| {
            if (feed_tag.feed_id != feed_id) {
                return slice[0..i];
            }
        }
        return slice[0..];
    }

    return null;
}

fn get_tag_name(tag_id: feed_types.SqliteId, tags: []const TagResult) ?[]const u8 {
    for (tags) |tag| {
        if (tag_id == tag.tag_id) {
            return tag.name;
        }
    }
    return null;
}

fn feed_items_slice(feed_id: feed_types.Feed.ID, items: []const feed_types.FeedItemRender) ?[]const feed_types.FeedItemRender {
    var start: ?usize = null;
    for (items, 0..) |item, i| {
        if (item.feed_id == feed_id) {
            start = i;
            break;
        }
    }

    if (start) |s| {
        const slice = items[s..];
        for (slice[1..], 1..) |item, i| {
            if (item.feed_id != feed_id) {
                return slice[0..i];
            }
        }
        return slice[0..];
    }

    return null;
}

pub const TagEditOpts = struct {
    title: []const u8,
    tag: TagResult,
    query_error: ?UrlQueryError = null,
    query_is_success: bool = false,
};

pub templ TagEditPage(opts: TagEditOpts, nav: Navigation) {
    @Layout(opts.title, nav) {
        <main class="flow">
          <h2>{opts.title}</h2>
          if (opts.query_is_success) {
              <div><p class="callout success">Changes saved</p></div>
          } else if (opts.query_error == .invalid_form) {
              <div><p class="callout danger">Invalid form</p></div>
          }

          <form class="flow" method="post">
            <div>
              <div>
                <label for="tag-name">Tag name</label>
              </div>
              <input class="char-len-s" type="text" id="tag-name" name="tag-name" value={opts.tag.name} />
            </div>
            <input type="hidden" name="tag-id" value={opts.tag.tag_id} />
            <div>
                <button class="muted primary" name="action" value="save">Save changes</button>
            </div>
            <button class="outline danger" name="action" value="delete">Delete tag</button>
          </form>
        </main>
    }
}

const IconIdClass = struct {
    value: feed_types.IconRender.ID,

    pub fn init(icon_id: feed_types.IconRender.ID) ?IconIdClass {
        if (icon_id.is_valid()) {
            return .{.value = icon_id};
        }
        return null;
    }

    pub fn format(self: @This(), writer: *std.Io.Writer) std.Io.Writer.Error!void {
        try writer.print("icon-id-{d}", .{self.value});
    }
};

pub const FeedOpts = struct {
    head_title: []const u8 = "",
    feed: feed_types.Feed,
    feed_items: []const feed_types.FeedItemRender,
    feed_tags: []const feed_types.SqliteId = &.{},
    last_update: ?i64,
    next_update: ?i64,
    now_sec: i64,
    failed_requests: []const Storage.FeedFailedRequest,
    query_success: bool = false,
    query_error: ?UrlQueryError = null,
    html_opts: ?@import("../feed_parse.zig").HtmlOptions = null,
    input_icon_url_or_data: []const u8 = "",
};

pub templ FeedPage(opts: FeedOpts, nav: Navigation) {
    @Layout(opts.head_title, nav) {
        <main class="flow">
            <h2 class={IconIdClass.init(opts.feed.icon_id)}>
                if (opts.feed.title) |title| {
                    {title}
                } else {
                    {title_placeholder}
                }
            </h2>

            <div class="feed-info flow">
                <p>
                    if (opts.feed.page_url) |page_url| {
                        Page link: <a href={page_url} class="inline-block" rel="noreferrer noopener">{page_url}</a>
                    } else {
                        Page link: [no-url]
                    }
                </p>
                <p>Feed link: <a href={opts.feed.feed_url} rel="noreferrer noopener">{opts.feed.feed_url}</a></p>

                if (opts.last_update) |last_update| {
                    <p>Last update was
                        <em><relative-time update="false">
                            <time datetime={zt.fmt(util.write_timestamp, .{last_update})}>{util.date_readable(last_update)}</time>
                        </relative-time></em>
                    </p>
                }

                if (opts.next_update) |next_update| {
                    <p>Next update
                        <em><relative-time update="false">
                            <time datetime={zt.fmt(util.write_timestamp, .{next_update})}>{util.date_readable(next_update)}</time>
                        </relative-time></em>
                    </p>
                } else {
                    <!--
                    TODO: add link/button to run update right now.
                    TODO: Add the button even if updating isn't disabled?
                    -->
                    <p class="callout warning">This feed's updating is disabled. Failed to fetch feed too many times.</p>
                }

                if (opts.failed_requests.len > 0) {
                    <table class="table-striped">
                        <caption>Failed request(s)</caption>
                        <tr>
                            <th>Date</th>
                            <th>Error</th>
                        </tr>

                    for (opts.failed_requests) |failed| {
                          <tr>
                              <td>
                                  <time datetime={zt.fmt(util.write_timestamp, .{failed.utc_sec})}>{util.date_readable(failed.utc_sec)}</time>
                              </td>
                              <td>{failed.reason}</td>
                          </tr>
                    }
                    </table>
                }

                if (opts.query_success) {
                    <p class="callout success">Feed changes saved</p>
                }

                if (opts.query_error) |err_enum| {
                    <p class="callout danger">
                    switch (err_enum) {
                        .delete => {Failed to delete feed},
                        .feed => {Failed to update feed},
                        .html => {Failed to update feed html fields},
                        .item_selector => {Fill in 'Feed item selector' field},
                        .icon_too_large => {'Icon url' size is too big. Allowed max size {Server.icon_input_max_size}},
                        .unknown => {Failed to save feed changes},
                        else => {},
                    }
                    </p>
                }

                <h3>Edit feed</h3>
                <form class="flow" method="POST">
                    <div>
                      <div><label for="title">Feed title</label></div>
                      <input class="char-len-l" type="text" id="title" name="title" value={opts.feed.title orelse ""} />
                    </div>
                    <div>
                      <div><label for="page_url">Page link</label></div>
                      <input type="text" id="page_url" name="page_url" value={opts.feed.page_url} />
                    </div>
                    <div>
                      <div><label for="icon_url">Icon link or data</label></div>
                      <input type="text" id="icon_url" name="icon_url" value={opts.input_icon_url_or_data} />
                    </div>

                    if (opts.html_opts) |html_opts| {
                        <fieldset class="flow">
                            <legend>Html 'feed' options</legend>
                            <div>
                                <div><label for="html-item-selector">Feed item selector</label></div>
                                <input class="char-len-m" type="text" value={html_opts.selector_container} name="html-item-selector" id="html-item-selector" />
                            </div>

                            <div>
                                <div><label for="html-link-selector">Feed item link selector</label></div>
                                <input class="char-len-m" type="text" value={html_opts.selector_link} name="html-link-selector" id="html-link-selector" />
                            </div>

                            <div>
                                <div><label for="html-title-selector">Feed item title selector</label></div>
                                <input class="char-len-m" type="text" value={html_opts.selector_heading} name="html-title-selector" id="html-title-selector" />
                            </div>

                            <div>
                                <div><label for="html-date-selector">Feed item date selector</label></div>
                                <input class="char-len-m" type="text" value={html_opts.selector_date} name="html-date-selector" id="html-date-selector" />
                            </div>

                            <div>
                                <div><label for="html-date-format">Date format</label></div>
                                <input class="char-len-m" type="text" value={html_opts.date_format} name="html-date-format" id="html-date-format" />
                            </div>
                        </fieldset>
                   }

                    <fieldset>
                      <legend>Tags</legend>
                      <div class="feed-tag-list">
                        for (nav.tags) |tag| {
                            <label for="tag-edit-{tag.tag_id}">
                                <input type="checkbox" name="tag" id="tag-edit-{tag.tag_id}" value="{tag.name}" checked?={is_tag_checked(tag.tag_id, opts.feed_tags)} />
                                <span class="truncate-1" title="{tag.name}">{tag.name}</span>
                            </label>
                        }
                      </div>
                    </fieldset>

                    <div class="form-input">
                      <div>
                        <label for="new_tags">New tags</label>
                        <em>Tags are comma separated</em>
                      </div>
                      <input type="text" id="new_tags" name="new_tags" />
                    </div>

                    <div>
                        <button class="muted primary" name="action" value="save">Save feed changes</button>
                    </div>
                    <div>
                        <button class="outline danger" name="action" value="delete">Delete feed</button>
                    </div>
                </form>
            </div>

            <h3>Feed items</h3>
            if (opts.feed_items.len == 0) {
                <p class="callout">No feeds items in this feed.</p>
            } else {
                <relative-time update="false" format-style="narrow" format-numeric="always">
                    <ul class="stack list-unstyled">
                    for (opts.feed_items) |item| {
                        <li class="feed-item">
                            @LatestItemRelativeTime(item.updated_timestamp, opts.now_sec)
                            @ItemLink(item)
                        </li>
                    }
                    </ul>
                </relative-time>
            }
        </main>
    }
}

pub const ErrorOpts = struct {
    err: anyerror,
};

pub templ ErrorPage(opts: ErrorOpts, nav: Navigation) {
    @Layout("Server error 500", nav) {
        <main>
            <p>Something went wrong on our side.</p>
            <p>Server error: {@errorName(opts.err)}</p>
        </main>
    }
}

